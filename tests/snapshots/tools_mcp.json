        "size_bytes"
      ],
      "type": "object"
    }
  },
  {
    "description": "Return the kind, size, modification time and guessed MIME type of a path.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "File or directory, relative to the sandbox root.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "name": "file_info",
    "outputSchema": {
      "properties": {
        "kind": {
          "enum": [
            "file",
            "dir",
            "symlink",
            "other"
          ],
          "type": "string"
        },
        "mime_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Guessed from the file name, not the content."
        },
        "modified": {
          "description": "Last modification time in UTC.",
          "format": "date-time",
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "size": {
          "description": "Size in bytes.",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "kind",
        "size",
        "modified",
        "mime_type"
      ],
      "type": "object"
    }
  },
  {
    "description": "Find regular files below a directory that match a glob pattern, sorted by path.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "max_results": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum matches to return. Defaults to the configured limit."
        },
        "path": {
          "default": ".",
          "description": "Directory to search from, relative to the root.",
          "type": "string"
        },
        "pattern": {
          "description": "Glob pattern such as '*.pdf' or '**/*.md'.",
          "type": "string"
        }
      },
      "required": [
        "pattern"
      ],
      "type": "object"
    },
    "name": "find_files",
    "outputSchema": {
      "$defs": {
        "FoundFile": {
          "properties": {
            "path": {
              "type": "string"
            },
            "size": {
              "type": "integer"
            }
          },
          "required": [
            "path",
            "size"
          ],
          "type": "object"
        }
      },
      "properties": {
        "matches": {
          "items": {
            "$ref": "#/$defs/FoundFile"
          },
          "type": "array"
        },
        "truncated": {
          "description": "True when more files matched than were returned.",
          "type": "boolean"
        }
      },
      "required": [
        "matches",
        "truncated"
      ],
      "type": "object"
    }
  },
  {
    "description": "List the files and directories directly inside a directory.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "include_hidden": {
          "default": false,
          "description": "Include names starting with a dot.",
          "type": "boolean"
        },
        "max_entries": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum entries to return. Defaults to the configured limit."
        },
        "path": {
          "default": ".",
          "description": "Directory to list, relative to the sandbox root.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "list_dir",
    "outputSchema": {
      "$defs": {
        "DirEntry": {
          "properties": {
            "kind": {
              "enum": [
                "file",
                "dir",
                "symlink",
                "other"
              ],
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "size": {
              "type": "integer"
            }
          },
          "required": [
            "name",
            "path",
            "kind",
            "size"
          ],
          "type": "object"
        }
      },
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/DirEntry"
          },
          "type": "array"
        },
        "path": {
          "type": "string"
        },
        "truncated": {
          "description": "True when more entries exist than were returned.",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "entries",
        "truncated"
      ],
      "type": "object"
    }
  },
  {
    "description": "Describe an audio or video file: container, duration, bit rate and every stream.\n\nStreams list codec, resolution and frame rate (video) or sample rate and channels\n(audio). Use it before converting or trimming to see what a file contains.",
