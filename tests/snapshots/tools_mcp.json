[
  {
    "description": "Return the kind, size, modification time and guessed MIME type of a path.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "File or directory, relative to the sandbox root.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "name": "file_info",
    "outputSchema": {
      "properties": {
        "kind": {
          "enum": [
            "file",
            "dir",
            "symlink",
            "other"
          ],
          "type": "string"
        },
        "mime_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Guessed from the file name, not the content."
        },
        "modified": {
          "description": "Last modification time in UTC.",
          "format": "date-time",
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "size": {
          "description": "Size in bytes.",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "kind",
        "size",
        "modified",
        "mime_type"
      ],
      "type": "object"
    }
  },
  {
    "description": "List the files and directories directly inside a directory.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "include_hidden": {
          "default": false,
          "description": "Include names starting with a dot.",
          "type": "boolean"
        },
        "max_entries": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum entries to return. Defaults to the configured limit."
        },
        "path": {
          "default": ".",
          "description": "Directory to list, relative to the sandbox root.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "list_dir",
    "outputSchema": {
      "$defs": {
        "DirEntry": {
          "properties": {
            "kind": {
              "enum": [
                "file",
                "dir",
                "symlink",
                "other"
              ],
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "size": {
              "type": "integer"
            }
          },
          "required": [
            "name",
            "path",
            "kind",
            "size"
          ],
          "type": "object"
        }
      },
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/DirEntry"
          },
          "type": "array"
        },
        "path": {
          "type": "string"
        },
        "truncated": {
          "description": "True when more entries exist than were returned.",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "entries",
        "truncated"
      ],
      "type": "object"
    }
  },
  {
    "description": "Read a text file. Large files are cut at max_bytes and flagged as truncated.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "encoding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Text encoding. Detected automatically when omitted."
        },
        "max_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum bytes to read. Defaults to the configured limit."
        },
        "path": {
          "description": "File to read, relative to the sandbox root.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "name": "read_text",
    "outputSchema": {
      "properties": {
        "bytes_read": {
          "type": "integer"
        },
        "encoding": {
          "description": "The encoding that was used to decode the text.",
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "total_bytes": {
          "type": "integer"
        },
        "truncated": {
          "description": "True when the file is larger than what was read.",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "text",
        "encoding",
        "bytes_read",
        "total_bytes",
        "truncated"
      ],
      "type": "object"
    }
  }
]
