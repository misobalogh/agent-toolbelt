  {
    "description": "Read a text file. Large files are cut at max_bytes and flagged as truncated.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "encoding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
