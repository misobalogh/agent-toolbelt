[
  {
    "description": "Repeat a text a few times, optionally upper-cased.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "case": {
          "default": "keep",
          "enum": [
            "keep",
            "upper"
          ],
          "type": "string"
        },
        "repeat": {
          "default": 1,
          "description": "How many times to repeat it.",
          "maximum": 5,
          "minimum": 1,
          "type": "integer"
        },
        "suffix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "description": "Text to repeat.",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "name": "echo",
    "outputSchema": {
      "$defs": {
        "Line": {
          "properties": {
            "index": {
              "type": "integer"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "index",
            "text"
          ],
          "type": "object"
        }
      },
      "properties": {
        "lines": {
          "items": {
            "$ref": "#/$defs/Line"
          },
          "type": "array"
        }
      },
      "required": [
        "lines"
      ],
      "type": "object"
    }
  },
  {
    "description": "Check that the tool layer is alive.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "name": "ping",
    "outputSchema": {
      "properties": {
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ],
      "type": "object"
    }
  }
]
