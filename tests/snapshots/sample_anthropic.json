[
  {
    "description": "Repeat a text a few times, optionally upper-cased.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "case": {
          "default": "keep",
          "enum": [
            "keep",
            "upper"
          ],
          "type": "string"
        },
        "repeat": {
          "default": 1,
          "description": "How many times to repeat it.",
          "maximum": 5,
          "minimum": 1,
          "type": "integer"
        },
        "suffix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "description": "Text to repeat.",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "name": "echo"
  },
  {
    "description": "Check that the tool layer is alive.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "name": "ping"
  }
]
